# Google Antigravity Project - Environment Variables Template
# Copy this file to .env and fill in your actual keys.
# DO NOT commit .env to version control.

# Google Gemini API Key
# Get yours at https://aistudio.google.com/
GEMINI_API_KEY_FREE=your_free_api_key_here
GEMINI_API_KEY_PAID=your_paid_api_key_here

# Google Maps API Key
# Get yours at Google Cloud Console
GOOGLE_MAPS_API_KEY=YOUR_MAPS_API_KEY_HERE
